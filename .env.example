DATABASE_URL="postgresql://vms:vms@localhost:5432/vms?schema=public"
# ใช้เซ็น QR Pass Token และ hash เลขบัตร (สุ่มด้วย: openssl rand -base64 32)
PASS_TOKEN_SECRET="change-me-pass-secret"
ID_HASH_SECRET="change-me-id-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# บัญชีผู้ดูแลระบบคนแรก — npm run user:admin
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="change-me-123"

# LINE Messaging API (แจ้งเตือน Host) — จาก LINE Developers Console > Messaging API channel
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
# Basic ID ของ LINE OA เช่น @123abcde (ใช้ทำลิงก์เพิ่มเพื่อน)
LINE_OA_BASIC_ID=""

# Cloudflare Named Tunnel (URL ถาวร) — เว้นว่างไว้เพื่อใช้ Quick Tunnel
CLOUDFLARE_TUNNEL_TOKEN=""
# URL สาธารณะ เช่น https://vms.example.com (Named Tunnel ต้องตั้ง; Quick Tunnel ระบบตั้งให้เอง)
APP_URL=""

# อีเมล (ยืนยันการสมัคร) — เว้นว่าง = แสดงอีเมลใน log ของเซิร์ฟเวอร์แทน
# ตัวอย่าง: smtps://USER:PASS@smtp.gmail.com:465  หรือ  smtps://resend:API_KEY@smtp.resend.com:465
SMTP_URL=""
MAIL_FROM="VMS <no-reply@example.com>"

# ระบบเก็บเงิน (โอน + แนบสลิป) — ข้อมูลผู้ขายบนใบแจ้งหนี้/ใบกำกับภาษี
SELLER_NAME="[ชื่อบริษัทผู้ให้บริการ]"
SELLER_TAX_ID=""
SELLER_BRANCH="สำนักงานใหญ่"
SELLER_ADDRESS=""
BANK_NAME=""
BANK_ACCOUNT_NAME=""
BANK_ACCOUNT_NO=""
# เบอร์มือถือหรือเลข 13 หลักที่ผูก PromptPay (ใช้สร้าง QR พร้อมยอดเงิน)
PROMPTPAY_ID=""
# องค์กรของผู้ให้บริการ — ผู้ดูแลองค์กรนี้ตรวจสลิปได้ / อีเมลรับแจ้งเตือนสลิปใหม่
PLATFORM_ORG_SLUG="main"
PLATFORM_BILLING_EMAIL=""

# --- ตรวจสลิปอัตโนมัติ ---
# ระบบอ่าน QR บนสลิปในเครื่องและกันสลิปซ้ำเสมอ
# ใส่ API key ของ EasySlip (https://developer.easyslip.com) เพื่อตรวจยอดเงิน/ผู้รับกับธนาคาร
# ส่งออกไปเฉพาะข้อความใน QR (เลขอ้างอิงรายการ) — ไม่ส่งรูปสลิป
EASYSLIP_API_KEY=""
# สลิปผ่านทุกข้อ → อนุมัติและออกใบเสร็จเองทันที (ตั้ง false = ให้คนกดอนุมัติเสมอ)
SLIP_AUTO_APPROVE="true"

# --- สำรองข้อมูลอัตโนมัติ (วันละครั้งขณะเปิดโปรแกรม) ---
# โฟลเดอร์เก็บไฟล์สำรองในเครื่อง (ค่าเริ่มต้น ~/VMS-Backups)
BACKUP_DIR=""
# สำเนาเข้ารหัสนอกเครื่อง เช่น ไดรฟ์ภายนอก "/Volumes/USB/VMS" หรือโฟลเดอร์ Google Drive/iCloud — ว่าง = ไม่ทำสำเนา
BACKUP_COPY_DIR=""
# กุญแจเข้ารหัสสำเนา (hex 64 ตัว) — เก็บไว้ที่อื่นด้วย (เช่น password manager) ไม่มีกุญแจ = เปิดสำเนาไม่ได้
BACKUP_KEY=""
# จำนวนไฟล์ล่าสุดที่เก็บไว้
BACKUP_KEEP="14"

# ---- เครื่องอ่านบัตรประชาชน (โปรแกรมเชื่อม: npm run card-agent) ----
# เว็บที่อนุญาตให้รับข้อมูลบัตร (คั่นด้วย ,) — ค่าเริ่มต้น: APP_URL + http://localhost:3000
CARD_AGENT_ORIGINS=""
# CARD_AGENT_PORT="47800"
# หน้าเว็บเชื่อมไปที่ (ถ้าเปลี่ยนพอร์ต)
# NEXT_PUBLIC_CARD_AGENT_URL="http://127.0.0.1:47800"
