{
  "name": "vms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/local-db.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate && node scripts/copy-ocr-assets.mjs",
    "user:admin": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/create-admin.ts",
    "retention:run": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/run-retention.ts",
    "online": "node scripts/online.mjs",
    "org:create": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/create-org.ts",
    "test:isolation": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/test-tenant-isolation.ts",
    "test:customers": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/test-customers.ts",
    "test:billing": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/test-billing.ts",
    "test:slip": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/test-slip.ts",
    "backup:now": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/backup-now.ts",
    "backup:restore": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/backup-restore.ts",
    "test:backup": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/test-backup.ts",
    "test:plate": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/test-plate-ocr.ts",
    "test:features": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/test-village-forms-reports.ts",
    "card-agent": "tsx --tsconfig tsconfig.json scripts/card-agent.ts",
    "test:cardreader": "tsx --tsconfig tsconfig.json scripts/test-card-reader.ts",
    "line:richmenu": "tsx --tsconfig tsconfig.json scripts/setup-rich-menu.ts",
    "test:points": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/test-points.ts",
    "test:invite": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/test-guest-invite.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@radix-ui/react-checkbox": "^1.3.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/tha": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.0.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.500.0",
    "next": "^16.0.0",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.3.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "prisma": "^7.0.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@pokusew/pcsclite@0.6.0": true
  },
  "optionalDependencies": {
    "@pokusew/pcsclite": "^0.6.0"
  }
}
